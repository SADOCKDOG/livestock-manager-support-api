{
  "name": "livestock-manager-support-api",
  "version": "0.1.0",
  "description": "Backend de soporte con IA para Livestock Manager — estructura incidencias y crea issues en GitHub vía GitHub App.",
  "main": "src/index.ts",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "kv:create": "wrangler kv:namespace create TICKETS_KV",
    "secret:put": "wrangler secret put",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "@octokit/auth-app": "^7.1.0",
    "@octokit/rest": "^21.0.0",
    "hono": "^4.13.8",
    "jose": "^5.9.0"
  }
}
